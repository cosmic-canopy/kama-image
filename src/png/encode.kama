// image::png's encoder (IMG-2; AGENTS.image.md § Decided, 4).
//
//   Result<DynamicArray<uint8>, ImageError> r = encode(image: img, options: EncodeOptions.archival());
//
// The image as it is held, at 8 or 16 bits: four channels as RGBA, two as grey with alpha and one as grey, except that
// an opaque image's alpha channel is not written (RGB, or grey). No palette, no depth below 8 and no interlacing. Each
// row is filtered as the options say, `Adaptive` choosing as libpng's writer chooses, and the rows are deflated at the
// options' level into IDAT chunks of 65,536 bytes, the last no longer: the bytes depend only on the image and the
// options. What PNG cannot hold, premultiplied alpha and float samples, is refused, never converted.
//
// The colour chunks make the file decode back to the image's colour space with everything the image carries: what it
// carries (a cICP, an ICC profile, a rendering intent, Exif, a mastering display, light levels) is written back as it
// is, and its colour space is written where they do not give it. The check is the decoder's own precedence (`spaceOf`),
// so metadata that contradicts the colour space, or that PNG cannot hold, is refused as `Metadata`. The chunks go in
// libpng's order: IHDR, cLLI, mDCV, cICP, iCCP, sRGB, gAMA, cHRM, eXIf, IDAT, IEND.

import {
    std::collections::DynamicArray, std::collections::FixedArray, std::collections::ConstView,
    std::compress::zlib::ZlibWriter, std::compress::deflate::DeflateLevel, std::io::IoError, std::io::Writer,
    std::io::Unfinished, std::io::StringWriter,
    std::digest::crc32::crc32,
    image::Image, image::ImageError, image::ImageErrorKind, image::PixelFormat, image::AlphaMode, image::ColorSpace,
    image::Primaries, image::Transfer, image::Chromaticities, image::RenderingIntent, image::Cicp, image::MasteringDisplay,
    image::ContentLight,
    image::png::detail::IHDR, image::png::detail::IDAT, image::png::detail::IEND, image::png::detail::CICP,
    image::png::detail::ICCP, image::png::detail::SRGB, image::png::detail::GAMA, image::png::detail::CHRM,
    image::png::detail::MDCV, image::png::detail::CLLI, image::png::detail::EXIF, image::png::detail::be32,
    image::png::detail::paeth, image::png::detail::Chunks, image::png::detail::iccValid, image::png::detail::spaceOf,
    EncodeOptions, Filter,
};

export { encode };

// The bytes of every IDAT chunk but the last: fixed, so the chunks depend on the deflated stream alone, and a writer that
// streams to a file could hold this much at a time and write the same bytes.
comptime isize IDAT_BYTES = 65536;

fn Result<DynamicArray<uint8>, ImageError> refuse(ImageErrorKind kind, uint32 chunk) {
    return Result::Err(error: ImageError.make(kind: kind, at: -1, chunk: chunk));
}

fn void put32(ref DynamicArray<uint8> b, uint32 v) {
    b.add(item: truncate<uint8>(v >> 24));
    b.add(item: truncate<uint8>(v >> 16));
    b.add(item: truncate<uint8>(v >> 8));
    b.add(item: truncate<uint8>(v));
}

fn void put16(ref DynamicArray<uint8> b, uint16 v) {
    b.add(item: truncate<uint8>(v >> 8));
    b.add(item: truncate<uint8>(v));
}

// One chunk onto `file`: its length, its type, its data, and the CRC-32 of its type and data. The data is at most 2³¹ − 1
// bytes, which every caller holds to.
fn void putChunk(ref DynamicArray<uint8> file, uint32 kind, ConstView<uint8> data) {
    put32(b: ref file, v: cast<uint32>(data.length()));
    isize start = file.length();
    put32(b: ref file, v: kind);
    file.addAll(items: data);
    uint32 sum = crc32(bytes: file.slice(from: start, count: file.length() - start));
    put32(b: ref file, v: sum);
}

// The deflated image data as it arrives, cut into IDAT chunks of exactly IDAT_BYTES onto the file, the last no longer.
type resource IdatSink implements Writer {
    DynamicArray<uint8> file;
    FixedArray<uint8> held;
    isize count;

    public ctor make(DynamicArray<uint8> file) {
        this.file = give file;
        this.held = FixedArray.make(size: IDAT_BYTES);
        this.count = 0;
    }

    public fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        isize n = bytes.length();
        isize i = 0;
        while (i < n) {
            isize room = IDAT_BYTES - this.count;
            isize step = n - i < room ? n - i : room;
            for (isize k = 0; k < step; k = k + 1) { this.held[this.count + k] = bytes[i + k]; }
            this.count = this.count + step;
            i = i + step;
            if (this.count == IDAT_BYTES) { this.emit(); }
        }
        return Result::Ok(value: n);
    }

    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    fn void emit() {
        putChunk(file: ref this.file, kind: IDAT, data: this.held.view().slice(from: 0, count: this.count));
        this.count = 0;
    }

    // The file, with the last IDAT chunk on it.
    public give fn DynamicArray<uint8> finish() {
        if (this.count > 0) { this.emit(); }
        return give this.file;
    }
}

// Row `y` of 8-bit samples as PNG holds it: the first `written` of each pixel's `held` samples.
fn void rowOf8(ConstView<uint8> s, isize y, isize w, isize held, isize written, ref FixedArray<uint8> row) {
    isize from = y * w * held;
    isize at = 0;
    for (isize x = 0; x < w; x = x + 1) {
        for (isize c = 0; c < written; c = c + 1) { row[at + c] = s[from + c]; }
        at = at + written;
        from = from + held;
    }
}

// Row `y` of 16-bit samples as PNG holds it: the first `written` of each pixel's `held` samples, big-endian.
fn void rowOf16(ConstView<uint16> s, isize y, isize w, isize held, isize written, ref FixedArray<uint8> row) {
    isize from = y * w * held;
    isize at = 0;
    for (isize x = 0; x < w; x = x + 1) {
        for (isize c = 0; c < written; c = c + 1) {
            uint16 v = s[from + c];
            row[at + c * 2] = truncate<uint8>(v >> 8);
            row[at + c * 2 + 1] = truncate<uint8>(v);
        }
        at = at + written * 2;
        from = from + held;
    }
}

// Byte `i` of a row under filter `kind` (the PNG Third Edition, § 9.2): the byte less its prediction from the byte a whole
// pixel to its left (`bpp` bytes), the byte above it, and the one above that one's left. The row above the first is 0.
fn uint8 filtered(const ref FixedArray<uint8> cur, const ref FixedArray<uint8> prev, isize i, isize bpp, int32 kind) {
    if (kind == 0) { return cur[i]; }
    int32 x = cast<int32>(cur[i]);
    int32 a = i >= bpp ? cast<int32>(cur[i - bpp]) : 0;
    int32 b = cast<int32>(prev[i]);
    if (kind == 1) { return truncate<uint8>(x - a); }
    if (kind == 2) { return truncate<uint8>(x - b); }
    if (kind == 3) { return truncate<uint8>(x - ((a + b) >> 1)); }
    int32 c = i >= bpp ? cast<int32>(prev[i - bpp]) : 0;
    return truncate<uint8>(x - paeth(a: a, b: b, c: c));
}

// What libpng's writer weighs a row filtered by `kind` at (pngwutil.c's png_write_find_filter): each filtered byte read
// as a signed number, its size summed. It stops once the sum passes `limit`, which then cannot win.
fn int64 cost(const ref FixedArray<uint8> cur, const ref FixedArray<uint8> prev, isize bpp, int32 kind, int64 limit) {
    int64 sum = 0;
    for (isize i = 0; i < cur.length(); i = i + 1) {
        int32 v = cast<int32>(filtered(cur: cur, prev: prev, i: i, bpp: bpp, kind: kind));
        sum = sum + cast<int64>(v < 128 ? v : 256 - v);
        if (sum > limit) { break; }
    }
    return sum;
}

// The filter libpng's writer takes for a row with all five allowed: the least cost, the earlier on a tie, None first. An
// image one row high allows only None and Sub, and one a column wide only None and Up, as libpng's png_write_start_row
// allows them.
fn int32 adaptive(const ref FixedArray<uint8> cur, const ref FixedArray<uint8> prev, isize bpp, isize w, isize h) {
    int64 mins = cost(cur: cur, prev: prev, bpp: bpp, kind: 0, limit: 0x7fffffffffffffffi64);
    int32 best = 0;
    for (int32 kind = 1; kind <= 4; kind = kind + 1) {
        bool allowed = kind == 1 ? w > 1 : kind == 2 ? h > 1 : w > 1 && h > 1;
        if (!allowed) { continue; }
        int64 sum = cost(cur: cur, prev: prev, bpp: bpp, kind: kind, limit: mins);
        if (sum < mins) { mins = sum; best = kind; }
    }
    return best;
}

// A fixed filter's number in the file, or -1 for `Adaptive`.
fn int32 kindOf(Filter filter) {
    return match (filter) {
        case Adaptive: -1; case None: 0; case Sub: 1; case Up: 2; case Average: 3; case Paeth: 4;
    };
}

// Every byte onto the deflater; false when it fails, which a sink in memory never does.
fn bool deflate(ref ZlibWriter<IdatSink> z, ConstView<uint8> bytes) {
    isize off = 0;
    while (off < bytes.length()) {
        Result<isize, IoError> r = z.write(bytes: bytes.slice(from: off, count: bytes.length() - off));
        isize n = match (r) { case Ok(value: k): k; case Err(error: e): -1; };
        if (n <= 0) { return false; }
        off = off + n;
    }
    return true;
}

// What the PNG Third Edition's cICP calls a set of primaries this package names (H.273): -1 for one it does not.
fn int32 cicpPrimariesOf(Primaries p) {
    return match (p) { case Bt709: 1; case Bt2020: 9; case DisplayP3: 12; case _: -1; };
}

// What cICP calls a transfer this package names (H.273): -1 for one it does not.
fn int32 cicpTransferOf(Transfer t) {
    return match (t) { case Srgb: 13; case Linear: 8; case Pq: 16; case Hlg: 18; case _: -1; };
}

// The chromaticities a cHRM chunk gives a named set of primaries: BT.709's are the PNG Third Edition's Table 17, as the
// decoder names them; all 0 for any other.
fn Chromaticities chromaticitiesOf(Primaries p) {
    return match (p) {
        case Bt709: Chromaticities.make(whiteX: 31270, whiteY: 32900, redX: 64000, redY: 33000, greenX: 30000, greenY: 60000,
                                        blueX: 15000, blueY: 6000);
        case DisplayP3: Chromaticities.make(whiteX: 31270, whiteY: 32900, redX: 68000, redY: 32000, greenX: 26500, greenY: 69000,
                                            blueX: 15000, blueY: 6000);
        case Bt2020: Chromaticities.make(whiteX: 31270, whiteY: 32900, redX: 70800, redY: 29200, greenX: 17000, greenY: 79700,
                                         blueX: 13100, blueY: 4600);
        case _: Chromaticities.none();
    };
}

fn bool sameChromaticities(const ref Chromaticities a, const ref Chromaticities b) {
    return a.whiteX == b.whiteX && a.whiteY == b.whiteY && a.redX == b.redX && a.redY == b.redY
        && a.greenX == b.greenX && a.greenY == b.greenY && a.blueX == b.blueX && a.blueY == b.blueY;
}

fn bool unset(const ref Chromaticities c) { return sameChromaticities(a: c, b: Chromaticities.none()); }

// Whether a cHRM chunk holds them: PNG stores each as an unsigned number.
fn bool storable(const ref Chromaticities c) {
    return c.whiteX >= 0 && c.whiteY >= 0 && c.redX >= 0 && c.redY >= 0 && c.greenX >= 0 && c.greenY >= 0 && c.blueX >= 0
        && c.blueY >= 0;
}

// Whether colour chunks that give `got` give `want` back: the same primaries and transfer, and the gamma and the
// chromaticities `want` holds, where it holds them. A colour space a program names holds neither; one a gAMA or cHRM
// gave holds what they said.
fn bool gives(const ref ColorSpace got, const ref ColorSpace want) {
    if (got.primaries != want.primaries || got.transfer != want.transfer) { return false; }
    if (want.gamma != 0ui32 && got.gamma != want.gamma) { return false; }
    if (!unset(c: want.chromaticities) && !sameChromaticities(a: got.chromaticities, b: want.chromaticities)) { return false; }
    return true;
}

// An ICC profile's name as iCCP holds it, in Latin-1, or empty when PNG cannot hold it: the PNG Third Edition (§ 11.3.2.3)
// takes 1 to 79 printable Latin-1 characters and spaces, with no leading, trailing or consecutive space. libpng's writer
// rewrites a name that breaks this; this encoder refuses it.
fn DynamicArray<uint8> keywordOf(const ref string name) {
    DynamicArray<uint8> k = DynamicArray.empty();
    bool space = true;
    foreach (char ch in name.chars()) {
        uint32 v = cast<uint32>(ch);
        if (v == 32ui32) {
            if (space) { return DynamicArray.empty(); }
            space = true;
        } else if ((v > 32ui32 && v <= 126ui32) || (v >= 161ui32 && v <= 255ui32)) {
            space = false;
        } else {
            return DynamicArray.empty();
        }
        k.add(item: truncate<uint8>(v));
    }
    if (space || k.length() > 79) { return DynamicArray.empty(); }
    return give k;
}

// The colour chunks `image` is written with, into `c`, at colour type `colourType`: what it carries, written back as it
// is, then its colour space where they do not give it. -1 when the file would decode to the image's colour space with
// everything it carries; otherwise the chunk that cannot be written, or 0 for a colour space PNG cannot state.
fn int64 colourChunks(const ref Image image, uint8 colourType, ref Chunks c) {
    Optional<Cicp> carried = image.cicp();
    bool matrixed = false;
    match (carried) {
        case Some(value: v): {
            matrixed = v.matrix != 0;
            c.hasCicp = true;
            c.cicpPrimaries = cast<int32>(v.primaries);
            c.cicpTransfer = cast<int32>(v.transfer);
            c.cicpMatrix = cast<int32>(v.matrix);
            c.cicpRange = v.fullRange ? 1 : 0;
        }
        case None: { }
    };
    // PNG holds RGB only, so cICP's matrix is 0 (the PNG Third Edition, § 11.3.2.6)
    if (matrixed) { return cast<int64>(CICP); }
    bool profiled = false;
    bool usable = false;
    borrow image.iccProfile() as p {
        profiled = p.length() > 0;
        if (profiled) { usable = iccValid(b: p, colourType: cast<int64>(colourType)); }
    }
    if (profiled) {
        string name = image.iccProfileName();
        DynamicArray<uint8> keyword = keywordOf(name: name);
        if (!usable || keyword.length() == 0) { return cast<int64>(ICCP); }
        c.hasIcc = true;
    }
    Optional<RenderingIntent> intent = image.renderingIntent();
    match (intent) {
        case Some(value: i): {
            c.hasSrgb = true;
            int32 n = match (i) { case Perceptual: 0; case RelativeColorimetric: 1; case Saturation: 2; case AbsoluteColorimetric: 3; };
            c.intent = n;
        }
        case None: { }
    };
    ColorSpace want = image.colorSpace();
    ColorSpace given = spaceOf(c: c);
    if (gives(got: given, want: want)) { return -1; }

    // Nothing carried gives the colour space, so it is written: sRGB for sRGB, a cICP for another space cICP names, and
    // gAMA and cHRM for one they give.
    bool fromChunks = want.gamma != 0ui32 || !unset(c: want.chromaticities);
    int32 cp = cicpPrimariesOf(p: want.primaries);
    int32 tf = cicpTransferOf(t: want.transfer);
    if (want.primaries == Primaries::Bt709 && want.transfer == Transfer::Srgb && !fromChunks) {
        c.hasSrgb = true;
    } else if (cp >= 0 && tf >= 0 && !fromChunks && !c.hasCicp) {
        c.hasCicp = true;
        c.cicpPrimaries = cp;
        c.cicpTransfer = tf;
        c.cicpMatrix = 0;
        c.cicpRange = 1;
    } else {
        uint32 g = want.transfer == Transfer::Linear && want.gamma == 0ui32 ? 100000ui32 : want.gamma;
        if ((want.transfer == Transfer::Gamma || want.transfer == Transfer::Linear) && g >= 1ui32 && g <= 0x7fffffffui32) {
            c.hasGamma = true;
            c.gamma = cast<int64>(g);
        }
        Chromaticities ch = unset(c: want.chromaticities) ? chromaticitiesOf(p: want.primaries) : want.chromaticities;
        if (!unset(c: ch) && storable(c: ch)) {
            c.hasChrm = true;
            c.chrm = ch;
        }
    }
    ColorSpace again = spaceOf(c: c);
    return gives(got: again, want: want) ? -1i64 : 0i64;
}

// The bytes as a zlib stream deflated at `level`; empty if the deflater failed, which in memory it does not.
fn DynamicArray<uint8> zlibOf(ConstView<uint8> bytes, DeflateLevel level) {
    ZlibWriter<StringWriter> z = ZlibWriter.make(sink: StringWriter.make(), level: level);
    isize off = 0;
    while (off < bytes.length()) {
        Result<isize, IoError> r = z.write(bytes: bytes.slice(from: off, count: bytes.length() - off));
        isize n = match (r) { case Ok(value: k): k; case Err(error: e): -1; };
        if (n <= 0) { break; }
        off = off + n;
    }
    Result<StringWriter, Unfinished<ZlibWriter<StringWriter>>> done = give z.finish();
    DynamicArray<uint8> packed = DynamicArray.empty();
    match (give done) {
        case Ok(value: s): { StringWriter w = give s; packed = give w.takeBytes(); }
        case Err(error: u): { }
    };
    if (off < bytes.length()) { return DynamicArray.empty(); }
    return give packed;
}

fn Result<DynamicArray<uint8>, ImageError> encode(const ref Image image, const ref EncodeOptions options) {
    // What PNG cannot hold is refused: it says neither premultiplied alpha nor floats.
    bool unorm = match (image.format()) {
        case R8Unorm: true; case Rg8Unorm: true; case Rgba8Unorm: true;
        case R16Unorm: true; case Rg16Unorm: true; case Rgba16Unorm: true;
        case Rgba16Float: false; case Rgba32Float: false;
    };
    if (!unorm || image.alpha() == AlphaMode::Premultiplied) { return refuse(kind: ImageErrorKind::Unsupported, chunk: 0); }
    // Rows a partial decode never had would be written as if they were the image.
    if (image.isPartial()) { return refuse(kind: ImageErrorKind::Truncated, chunk: 0); }
    isize w = image.width();
    isize h = image.height();
    if (cast<int64>(w) > 0x7fffffffi64 || cast<int64>(h) > 0x7fffffffi64) { return refuse(kind: ImageErrorKind::Header, chunk: IHDR); }

    // As held, but an opaque image's alpha channel is not written.
    isize held = image.format().channels();
    isize sb = image.format().sampleBytes();
    bool alpha = (held == 2 || held == 4) && image.alpha() != AlphaMode::Opaque;
    isize written = alpha ? held : (held == 4 ? 3 : 1);
    uint8 colourType = written == 1 ? 0 : written == 2 ? 4 : written == 3 ? 2 : 6;
    isize bpp = written * sb;
    isize rowBytes = w * bpp;

    // The colour chunks, the profile and the Exif data, refused before anything is written when PNG cannot hold them.
    Chunks c = Chunks.none();
    int64 unwritable = colourChunks(image: image, colourType: colourType, c: ref c);
    if (unwritable >= 0) { return refuse(kind: ImageErrorKind::Metadata, chunk: cast<uint32>(unwritable)); }
    bool exifBad = false;
    borrow image.exif() as e {
        isize n = e.length();
        if (n > 0) {
            uint32 mark = n >= 4 ? be32(b: e, at: 0) : 0ui32;
            exifBad = (mark != 0x49492A00ui32 && mark != 0x4D4D002Aui32) || cast<int64>(n) > 0x7fffffffi64;
        }
    }
    if (exifBad) { return refuse(kind: ImageErrorKind::Metadata, chunk: EXIF); }
    DynamicArray<uint8> profileData = DynamicArray.empty();
    if (c.hasIcc) {
        string name = image.iccProfileName();
        profileData = keywordOf(name: name);
        profileData.add(item: 0);   // the name's end
        profileData.add(item: 0);   // deflate
        borrow image.iccProfile() as prof {
            DynamicArray<uint8> packed = zlibOf(bytes: prof, level: options.level);
            profileData.addAll(items: packed.view());
        }
        if (cast<int64>(profileData.length()) > 0x7fffffffi64) { return refuse(kind: ImageErrorKind::Metadata, chunk: ICCP); }
    }

    DynamicArray<uint8> file = DynamicArray.empty();
    InlineArray<uint8>#(8) signature = [137, 80, 78, 71, 13, 10, 26, 10];
    for (isize i = 0; i < 8; i = i + 1) { file.add(item: signature[i]); }
    DynamicArray<uint8> header = DynamicArray.empty();
    put32(b: ref header, v: cast<uint32>(w));
    put32(b: ref header, v: cast<uint32>(h));
    header.add(item: truncate<uint8>(sb * 8));
    header.add(item: colourType);
    header.add(item: 0);   // deflate
    header.add(item: 0);   // adaptive filtering
    header.add(item: 0);   // no interlacing
    putChunk(file: ref file, kind: IHDR, data: header.view());
    Optional<ContentLight> light = image.contentLight();
    match (light) {
        case Some(value: l): {
            DynamicArray<uint8> d = DynamicArray.empty();
            put32(b: ref d, v: l.maxCll);
            put32(b: ref d, v: l.maxFall);
            putChunk(file: ref file, kind: CLLI, data: d.view());
        }
        case None: { }
    };
    Optional<MasteringDisplay> display = image.masteringDisplay();
    match (display) {
        case Some(value: m): {
            DynamicArray<uint8> d = DynamicArray.empty();
            put16(b: ref d, v: m.redX); put16(b: ref d, v: m.redY);
            put16(b: ref d, v: m.greenX); put16(b: ref d, v: m.greenY);
            put16(b: ref d, v: m.blueX); put16(b: ref d, v: m.blueY);
            put16(b: ref d, v: m.whiteX); put16(b: ref d, v: m.whiteY);
            put32(b: ref d, v: m.maxLuminance);
            put32(b: ref d, v: m.minLuminance);
            putChunk(file: ref file, kind: MDCV, data: d.view());
        }
        case None: { }
    };
    if (c.hasCicp) {
        DynamicArray<uint8> d = DynamicArray.empty();
        d.add(item: truncate<uint8>(c.cicpPrimaries));
        d.add(item: truncate<uint8>(c.cicpTransfer));
        d.add(item: truncate<uint8>(c.cicpMatrix));
        d.add(item: truncate<uint8>(c.cicpRange));
        putChunk(file: ref file, kind: CICP, data: d.view());
    }
    if (c.hasIcc) { putChunk(file: ref file, kind: ICCP, data: profileData.view()); }
    if (c.hasSrgb) {
        DynamicArray<uint8> d = DynamicArray.empty();
        d.add(item: truncate<uint8>(c.intent));
        putChunk(file: ref file, kind: SRGB, data: d.view());
        // and beside it the gAMA and cHRM the PNG Third Edition recommends (§ 11.3.2.5, Table 17), for a decoder that
        // reads no sRGB: libpng's png_set_sRGB_gAMA_and_cHRM
        c.hasGamma = true;
        c.gamma = 45455;
        c.hasChrm = true;
        c.chrm = chromaticitiesOf(p: Primaries::Bt709);
    }
    if (c.hasGamma) {
        DynamicArray<uint8> d = DynamicArray.empty();
        put32(b: ref d, v: cast<uint32>(c.gamma));
        putChunk(file: ref file, kind: GAMA, data: d.view());
    }
    if (c.hasChrm) {
        DynamicArray<uint8> d = DynamicArray.empty();
        InlineArray<int32>#(8) v = [c.chrm.whiteX, c.chrm.whiteY, c.chrm.redX, c.chrm.redY, c.chrm.greenX, c.chrm.greenY,
                                    c.chrm.blueX, c.chrm.blueY];
        for (isize k = 0; k < 8; k = k + 1) { put32(b: ref d, v: cast<uint32>(v[k])); }
        putChunk(file: ref file, kind: CHRM, data: d.view());
    }
    borrow image.exif() as e { if (e.length() > 0) { putChunk(file: ref file, kind: EXIF, data: e); } }

    // The rows, each filtered and deflated, onto IDAT chunks.
    ZlibWriter<IdatSink> z = ZlibWriter.make(sink: IdatSink.make(file: give file), level: options.level);
    FixedArray<uint8> prev = FixedArray.make(size: rowBytes);
    FixedArray<uint8> cur = FixedArray.make(size: rowBytes);
    FixedArray<uint8> line = FixedArray.make(size: rowBytes + 1);
    int32 fixedKind = kindOf(filter: options.filter);
    bool failed = false;
    for (isize y = 0; y < h; y = y + 1) {
        if (sb == 1) { borrow image.samples8() as s { rowOf8(s: s, y: y, w: w, held: held, written: written, row: ref cur); } }
        else { borrow image.samples16() as s { rowOf16(s: s, y: y, w: w, held: held, written: written, row: ref cur); } }
        int32 kind = fixedKind >= 0 ? fixedKind : adaptive(cur: cur, prev: prev, bpp: bpp, w: w, h: h);
        line[0] = truncate<uint8>(kind);
        for (isize i = 0; i < rowBytes; i = i + 1) { line[i + 1] = filtered(cur: cur, prev: prev, i: i, bpp: bpp, kind: kind); }
        if (!deflate(z: ref z, bytes: line.view())) { failed = true; break; }
        FixedArray<uint8> spare = give prev;
        prev = give cur;
        cur = give spare;
    }
    Result<IdatSink, Unfinished<ZlibWriter<IdatSink>>> done = give z.finish();
    DynamicArray<uint8> png = DynamicArray.empty();
    match (give done) {
        case Ok(value: sink): { IdatSink s = give sink; png = give s.finish(); }
        case Err(error: u): { failed = true; }
    };
    if (failed) { return refuse(kind: ImageErrorKind::Data, chunk: IDAT); }
    DynamicArray<uint8> none = DynamicArray.empty();
    putChunk(file: ref png, kind: IEND, data: none.view());
    return Result::Ok(value: give png);
}
